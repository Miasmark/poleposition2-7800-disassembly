{
  "_what": "The regression set for a split-screen build, for the toolkit's tools/regress.py. See tools/check-build.sh for what each check means and what a healthy build says.",
  "vars": {"out": "build/regress", "frames": "12000", "toolkit": "../a7800-toolkit"},
  "vars_cmd": "python tools/check-vars.py {out}",
  "cart": "{rom}",
  "jobs": [
    {"name": "health {r}",
     "for": {"r": ["run-02", "run-03", "test-pp2-2p-0923-0205", "test-pp2-2p-0923-0236"]},
     "script": "tools/probe-health-log.lua", "playback": "{r}.inp",
     "env": {"FRAMES": "{frames}"},
     "stdout": "{out}/health-{r}.csv", "stdout_grep": "^[0-9]",
     "verdict": "python tools/health.py {out}/health-{r}.csv"},
    {"name": "integrity {r}",
     "for": {"r": ["test-pp2-2p-0922-2037", "test-pp2-2p-0923-0205", "test-pp2-2p-0923-0236", "run-03"]},
     "script": "tools/probe-p2-list-integrity.lua", "playback": "{r}.inp",
     "env": {"HDR": "{out}/p2hdr.txt", "FR": "{frames}", "O": "{out}/integrity-{r}.txt"},
     "verdict_file": "{out}/integrity-{r}.txt"},
    {"name": "zrowup {r}",
     "for": {"r": ["run-03", "test-pp2-2p-0923-0205"]},
     "script": "tools/probe-zrowup-check.lua", "playback": "{r}.inp",
     "env": {"RTS": "{zr1} {zr2}", "END": "{frames}", "O": "{out}/zrowup-{r}.txt"},
     "verdict_file": "{out}/zrowup-{r}.txt"},
    {"name": "wild {r}",
     "for": {"r": ["run-02", "run-03", "test-pp2-2p-0923-0205"]},
     "script": "{toolkit}/probes/wildfetch.lua", "playback": "{r}.inp",
     "env": {"A7800_WF_RANGES": "8000-BFFF", "A7800_WF_WATCH": "9D",
             "A7800_WF_END": "{frames}", "A7800_WF_LOG": "{out}/wild-{r}.txt"},
     "verdict_file": "{out}/wild-{r}.txt", "verdict_line": "first"},
    {"name": "tick rate, start {a}",
     "for": {"a": ["211", "213", "214", "216", "218", "220"]},
     "script": "tools/probe-race-tickrate.lua",
     "env": {"CA": "7000", "CB": "7600", "NAVN": "2", "P2C": "{p2c}", "P2P": "{p2p}",
             "FR": "7602", "O": "{out}/tick-{a}.txt",
             "PHASES": "3900:{a}:210:-40:-40:1;30000:240:240:-40:-40:1"},
     "verdict_file": "{out}/tick-{a}.txt", "verdict_grep": "CC23=([0-9]+)"}
  ]
}
